{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yohaku Companion",
  "version": "0.3.0",
  "identifier": "dev.innei.yohaku-companion-win",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Yohaku Companion",
        "width": 960,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "externalBin": ["binaries/yohaku-core-node"],
    "resources": {
      "resources/core": "core"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGMzI2MEM5ODk4RTNBNjMKUldSak9vNkp5V0F5Yi9oYjRnVzYzYXlHNUdGT1hKeXE5c2NxeHF3eTU4WHNlQ0ZUZFRnT3NJTHMK",
      "endpoints": [
        "https://github.com/whitebearovo/YohakuCompanion-Win/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
